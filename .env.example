# Database Configuration
DB_USERNAME=medicalflow_user
DB_PASSWORD=SecurePassword@2026!Unique

# MySQL Root
MYSQL_ROOT_PASSWORD=RootPassword@2026!Unique

# JWT Configuration
JWT_SECRET=MedicalFlowJWT@2026SecretKeyForAuthenticationMin256BitsSuperSecure!
JWT_EXPIRATION=86400000

# AWS Configuration (Fill with your actual credentials)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY_HERE
AWS_REGION=us-east-1

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,https://yourdomain.com

# Grafana Configuration
GRAFANA_PASSWORD=GrafanaSecurePassword@2026

# Log Level Configuration
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
